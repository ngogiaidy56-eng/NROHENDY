[Unit]
Description=NROHENDY Game Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nrohend
Group=nrohend
WorkingDirectory=/opt/nrohend
ExecStart=/usr/bin/java -Xms512m -Xmx2g -jar /opt/nrohend/dist/NROHENDY.jar
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/nrohend/log /opt/nrohend/data

[Install]
WantedBy=multi-user.target